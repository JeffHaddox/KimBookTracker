rules_version = '2';

// Read Between: each person can only read and change their own shelf.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validBook(b) {
      return b.title is string && b.title.size() > 0 && b.title.size() <= 500
        && b.list in ['library', 'toread']
        && (!('img' in b) || (b.img is string && b.img.size() <= 400000))
        && (!('synopsis' in b) || (b.synopsis is string && b.synopsis.size() <= 20000))
        && (!('notes' in b) || (b.notes is string && b.notes.size() <= 20000));
    }

    // Account settings, such as the yearly reading goal
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid);

      // One document per book
      match /books/{bookId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBook(request.resource.data);
      }
    }
  }
}
